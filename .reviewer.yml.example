# CodeBleach configuration (v1). Unknown keys are rejected, so keep to this schema.
version: 1

review:
  enabled: true
  # Which finding categories the reviewer may report.
  categories:
    bugs: true
    security: true
    performance: false
    concurrency: true
  # Findings below these thresholds are discarded (but logged to the artifact).
  severity_threshold: medium
  confidence_threshold: 0.85
  # Per-category threshold overrides.
  category_overrides:
    security:
      confidence_threshold: 0.7
  # Cap on published comments per review; overflow goes in the summary.
  max_findings: 10
  # Files with more changed lines than this are skipped with a reason.
  max_changed_lines_per_file: 1500
  # Files with a larger head-commit blob than this are skipped with a reason.
  # Range 1..26623 (KB): an accepted blob plus its 1-byte sentinel must fit
  # the 26 MiB blob-read cap, so larger values are rejected at config load.
  max_file_size_kb: 500

ignore:
  # Additive: these entries EXTEND the built-in defaults
  # (**/*.lock, dist/**, build/**, node_modules/**, **/*.generated.*, **/*.snap, **/*.min.*),
  # which always apply. Duplicates are dropped; defaults come first.
  paths:
    - "dist/**"
    - "build/**"

# Primary language of the repository.
repository:
  language: typescript

# Context Engine time budgets. Enforced as parse <= total <= run.
context:
  max_run_time_ms: 120000
  max_parse_time_ms: 2000
  max_total_parse_time_ms: 30000
  # Approximate total review payload budget per ReviewUnit (hard cap).
  max_tokens_per_unit: 12000

# Fixed-model runtime controls (OpenCode Go + muse-spark-1.3-contributor only).
# No provider/model/api_family selectors exist — the target is pinned in code.
# Token ceilings are local safety bounds enforced before any request
# (see src/llm/limits.ts); no model limit.* was ever authenticated.
# review_timeout_ms is the overall review wall-clock deadline (all units,
# retries, and repairs); per-request timeout stays request_timeout_ms.
llm:
  request_timeout_ms: 90000
  max_output_tokens: 32768
  max_retries: 2
  max_concurrent_requests: 3
  max_review_unit_input_tokens: 64000
  review_timeout_ms: 600000

# Explicit repo rules. Cited by id in findings; violations may use the rule severity.
rules:
  - id: arch-001
    kind: architecture
    text: "Controllers must not contain business logic."
    paths:
      - "src/controllers/**"
    severity: medium

# Selective overrides applied to matching paths.
path_overrides:
  - paths:
      - "tests/**"
    review:
      categories:
        performance: false
